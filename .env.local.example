# დააკოპირე ეს ფაილი .env.local-ად და შეავსე რეალური მნიშვნელობებით.
# .env.local არასდროს აიტვირთოს GitHub-ზე (უკვე დამატებულია .gitignore-ში).

# Supabase-ის დაშბორდიდან: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# იგივე გვერდზე, "service_role" გასაღები — მხოლოდ admin API-სთვის, არასდროს გაუზიარო არავის
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ADMIN_PASSWORD აღარ არის საჭირო — admin-ში შესვლა ახლა Supabase Auth-ით
# (ელფოსტა + პაროლი) ხდება. იხილე README-ში „პირველი admin მომხმარებლის შექმნა".

# სურვილისამებრ — sitemap.xml/robots.txt/RSS/JSON-LD-ის აბსოლუტური ბმულებისთვის.
# არ დააყენო-ს შემთხვევაში ნაგულისხმევად "https://gjf.ge" გამოიყენება.
NEXT_PUBLIC_SITE_URL=https://gjf.ge

# სურვილისამებრ, მაგრამ production-ისთვის რეკომენდებული — Upstash Redis
# (უფასო ტარიფი), რომ /api/contact-messages და /api/search-ის rate limiting
# რეალურად იმუშაოს Vercel-ის serverless გარემოში. თუ არ დააყენებ, საიტი მაინც
# იმუშავებს — უბრალოდ სუსტი, in-memory ლიმიტერით. იხილე README-ში
# "Rate limiting-ის გამართვა".
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here
