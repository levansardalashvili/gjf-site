# დააკოპირე ეს ფაილი .env.local-ად და შეავსე რეალური მნიშვნელობებით.
# .env.local არასდროს აიტვირთოს GitHub-ზე (უკვე დამატებულია .gitignore-ში).

# Supabase-ის დაშბორდიდან: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# იგივე გვერდზე, "service_role" გასაღები — მხოლოდ admin API-სთვის, არასდროს გაუზიარო არავის
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# admin პანელში შესასვლელი პაროლი - თვითონ შეარჩიე, ძლიერი და უნიკალური
ADMIN_PASSWORD=choose-a-strong-password
